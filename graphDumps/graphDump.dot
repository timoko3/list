digraph G {
rankdir=LR
bgcolor="transparent"
nodesep = 1;
ranksep = 1
	node [shape=record, style="filled", fillcolor="#FFA089", fontcolor="black", color="#007CAD", penwidth=2.5, fontname="Tahoma", fontsize=25];

edge [color="#2d714f", arrowsize=1, penwidth=5, arrowhead="vee", style="bold"];
node0 [label="phys ind = 0 | head = 1 | tail = 6 | free_tail = 3", shape=record, style="filled", fillcolor="#222222", fontcolor="yellow", color="yellow", penwidth=2];
	node1 [label="phys idx = 1 | data = 10 | {prev = 0 | next = 2} "];
	node2 [label="phys idx = 2 | data = 20 | {prev = 1 | next = 4} "];
	node3 [label="phys idx = 3 | data = PZN | {prev = 6 | next = 7} "];
	node4 [label="phys idx = 4 | data = 40 | {prev = 2 | next = 5} "];
	node5 [label="phys idx = 5 | data = 50 | {prev = 4 | next = 6} "];
	node6 [label="phys idx = 6 | data = 45 | {prev = 5 | next = 0} "];

head_label      [shape=box, width = 2.4, height = 1.4, label="HEAD", style="filled", fillcolor="#BBDDEE", color="#6A5ACD", penwidth = 6,  fontcolor="darkblue", fontsize = 40];
tail_label      [shape=box, width = 2.4, height = 1.4, label="TAIL", style="filled", fillcolor="#BBDDEE", color="#c75a96ff", penwidth = 6,  fontcolor="darkblue", fontsize = 40];
free_head_label [shape=box, width = 2.4, height = 1.4, label="FREE", style="filled", fillcolor="#BBDDEE", color="#326932", penwidth = 6,  fontcolor="darkblue", fontsize = 40];
head_label      -> node1 [color="#6A5ACD"  , arrowsize=2.5, penwidth=3];
tail_label      -> node6 [color="#c75a96ff"  , arrowsize=2.5, penwidth=3];
free_head_label -> node3 [color="#326932"  , arrowsize=2.5, penwidth=3];
node0 -> node1[style=invis, weight = 100000];
	node1 -> node2 -> node3 -> node4 -> node5 -> node6[style=invis, weight=1000000];
	node0 -> node1[color="#6A5ACD:#c75a96ff", arrowsize=1.5, penwidth=5, weight=1000, constraint=false, dir = both];
node1 [fillcolor = "#6A5ACD:#c75a96ff", fontcolor = "#ffe9b5ff"]
node2 [fillcolor = "#6A5ACD:#c75a96ff", fontcolor = "#ffe9b5ff"]
node1 -> node2[color="#6A5ACD:#c75a96ff", arrowsize=1.5, penwidth=5, weight=1000, constraint=false, dir = both];
node2 [fillcolor = "#6A5ACD:#c75a96ff", fontcolor = "#ffe9b5ff"]
node4 [fillcolor = "#6A5ACD:#c75a96ff", fontcolor = "#ffe9b5ff"]
node2 -> node4[color="#6A5ACD:#c75a96ff", arrowsize=1.5, penwidth=5, weight=1000, constraint=false, dir = both];
node3 [fillcolor = "#16c56eff", fontcolor = "#222926ff"]
node7 [fillcolor = "#16c56eff", fontcolor = "#222926ff"]
node3 -> node7[color="#326932", arrowsize=1.5, penwidth=5, weight=1000, constraint=false, tailport = n];
node4 [fillcolor = "#6A5ACD:#c75a96ff", fontcolor = "#ffe9b5ff"]
node5 [fillcolor = "#6A5ACD:#c75a96ff", fontcolor = "#ffe9b5ff"]
node4 -> node5[color="#6A5ACD:#c75a96ff", arrowsize=1.5, penwidth=5, weight=1000, constraint=false, dir = both];
node5 [fillcolor = "#6A5ACD:#c75a96ff", fontcolor = "#ffe9b5ff"]
node6 [fillcolor = "#6A5ACD:#c75a96ff", fontcolor = "#ffe9b5ff"]
node5 -> node6[color="#6A5ACD:#c75a96ff", arrowsize=1.5, penwidth=5, weight=1000, constraint=false, dir = both];
node6 [fillcolor = "#6A5ACD:#c75a96ff", fontcolor = "#ffe9b5ff"]
node6 -> node0[color="#6A5ACD:#c75a96ff", arrowsize=1.5, penwidth=5, weight=1000, constraint=false, dir = both];

}