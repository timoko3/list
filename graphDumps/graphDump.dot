digraph G {
rankdir=LR
bgcolor="transparent"
nodesep = 1;
ranksep = 1
	node [shape=record, style="filled", fillcolor="#FFA089", fontcolor="black", color="#007CAD", penwidth=2.5, fontname="Tahoma", fontsize=25];

edge [color="#2d714f", arrowsize=1, penwidth=5, arrowhead="vee", style="bold"];
node0 [label="phys ind = 0 | head = 0 | tail = 0 | free_tail = 1", shape=record, style="filled", fillcolor="#222222", fontcolor="yellow", color="yellow", penwidth=2];
	node1 [label="phys idx = 1 | data = PZN | {prev = 0 | next = 2} "];
	node2 [label="phys idx = 2 | data = PZN | {prev = 1 | next = 3} "];

head_label      [shape=box, width = 2.4, height = 1.4, label="HEAD", style="filled", fillcolor="#BBDDEE", color="#6A5ACD", penwidth = 6,  fontcolor="darkblue", fontsize = 40];
tail_label      [shape=box, width = 2.4, height = 1.4, label="TAIL", style="filled", fillcolor="#BBDDEE", color="#c75a96ff", penwidth = 6,  fontcolor="darkblue", fontsize = 40];
free_head_label [shape=box, width = 2.4, height = 1.4, label="FREE", style="filled", fillcolor="#BBDDEE", color="#326932", penwidth = 6,  fontcolor="darkblue", fontsize = 40];
head_label      -> node0 [color="#6A5ACD"  , arrowsize=2.5, penwidth=3];
tail_label      -> node0 [color="#c75a96ff"  , arrowsize=2.5, penwidth=3];
free_head_label -> node1 [color="#326932"  , arrowsize=2.5, penwidth=3];
node0 -> node1[style=invis, weight = 100000];
	node1 -> node2[style=invis, weight=1000000];
	node1 [fillcolor = "#16c56eff", fontcolor = "#222926ff"]
node2 [fillcolor = "#16c56eff", fontcolor = "#222926ff"]
node1 -> node2[color="#326932", arrowsize=1.5, penwidth=5, weight=1000, constraint=false, tailport = n];
node2 [fillcolor = "#16c56eff", fontcolor = "#222926ff"]

}