digraph G {
rankdir=LR
bgcolor="transparent"
nodesep = 1;
ranksep = 1
	node [shape=record, style="filled", fillcolor="#FFA089", fontcolor="black", color="#007CAD", penwidth=2.5, fontname="Tahoma", fontsize=25];

node64 [label="address = 0x503000000040 | data = PZN | {tail = 0x503000000040 | head = 0x503000000040} ", shape=record, style="filled", fillcolor="#222222", fontcolor="yellow", color="yellow", penwidth=2];

head_label      [shape=box, width = 2.4, height = 1.4, label="HEAD", style="filled", fillcolor="#BBDDEE", color="#6A5ACD", penwidth = 6,  fontcolor="darkblue", fontsize = 40];
tail_label      [shape=box, width = 2.4, height = 1.4, label="TAIL", style="filled", fillcolor="#BBDDEE", color="#c75a96ff", penwidth = 6,  fontcolor="darkblue", fontsize = 40];
head_label      -> node64 [color="#6A5ACD"  , arrowsize=2.5, penwidth=3];
tail_label      -> node64 [color="#c75a96ff"  , arrowsize=2.5, penwidth=3];
	node64 -> node64[style=invis, weight = 100000];
	node64 
node64 -> node64[color="#6A5ACD:#c75a96ff", arrowsize=1.5, penwidth=5, weight=1000, constraint=false, dir = both];

}